{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lumina/org-manifest/v1",
  "title": "Lumina Org Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "orgId", "name", "deployedAt", "branding", "configuration", "vocabulary", "features", "permissions", "forms", "workflows"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "orgId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "deployedAt": { "type": "string", "format": "date-time" },
    "serverFetchedAt": { "type": "string", "format": "date-time" },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accent", "theme"],
      "properties": {
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "logoUrl": { "type": "string" },
        "theme": { "enum": ["dark"] }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "locale", "timezone"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "locale": { "type": "string", "minLength": 2 },
        "timezone": { "type": "string", "minLength": 1 },
        "fiscalYearStart": { "type": "string", "pattern": "^\\d{2}-\\d{2}$" }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "terms"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "label"],
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "label": {
                  "type": "object",
                  "additionalProperties": { "type": "string" },
                  "minProperties": 1
                },
                "aliases": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "toggleKey", "enabled", "requiredPermissions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "toggleKey": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "requiredPermissions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "permissions"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "permissions": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fields"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "type", "required"],
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "type": { "enum": ["text", "number", "date", "select", "multiselect", "boolean", "currency", "richtext"] },
                "required": { "type": "boolean" },
                "labelTerm": { "type": "string" },
                "optionsVocab": { "type": "string" },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "validationPattern": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "nodes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "transitions"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "enum": ["start", "task", "approval", "transition", "end"] },
                "transitions": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
