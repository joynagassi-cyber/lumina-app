// === ORG SETTINGS (Table 3: org_settings) — OrganizationAggregate ===
// Source: DOC-021 §1.3, DDL §Table 3
model OrgSetting {
  id               String   @id @default(uuid()) @db.Uuid
  org_id           String   @map("org_id") @db.Uuid
  cle_parametre    String   @map("cle_parametre") @db.VarChar(255)
  valeur_parametre Json   @map("valeur_parametre")
  mis_a_jour_par   String   @map("mis_a_jour_par") @db.Uuid
  mis_a_jour_le    DateTime @map("mis_a_jour_le") @db.Timestamptz(6)
  version          Int      @map("version") @default(1)

  org  Organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade)
  user User         @relation("OrgSettingUpdatedBy", fields: [mis_a_jour_par], references: [id])

  @@unique([cle_parametre, org_id])
  @@index([org_id])
  @@map("org_settings")
}

// === MEMBER RECORD (Table 8: members) — ResourceAggregate ===
// Source: DOC-021 §3.2, DDL §Table 8
model Member {
  id                      String   @id @default(uuid()) @db.Uuid
  org_id                  String   @map("org_id") @db.Uuid
  created_by              String?  @map("created_by") @db.Uuid
  prenom                  String   @map("prenom") @db.VarChar(100)
  nom_famille             String   @map("nom_famille") @db.VarChar(100)
  adresse_email           String?  @map("adresse_email") @db.VarChar(255)
  telephone               String?  @db.VarChar(30)
  date_naissance          DateTime? @map("date_naissance") @db.Date
  sexe                    String?  @db.VarChar(10)
  statut_membre           String   @map("statut_membre") @db.VarChar(20) @default("active")
  numero_membre           String   @map("numero_membre") @db.VarChar(50)
  date_entree             DateTime @map("date_entree") @db.Date
  date_sortie             DateTime?  @map("date_sortie") @db.Date
  certificat_transfert Json? @map("certificat_transfert")
  est_synchronise Boolean  @default(false) @map("est_synchronise")
  conflict_strategy       String   @map("conflict_strategy") @db.VarChar(32) @default("LWW")
  is_deleted              Boolean  @map("is_deleted") @default(false)
  purge_eligible_at       DateTime? @map("purge_eligible_at") @db.Timestamptz(6)
  created_at              DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  version                 Int      @map("version") @default(1)
  synced_at               DateTime? @map("synced_at") @db.Timestamptz(6)
  local_updated_at        DateTime? @map("local_updated_at") @db.Timestamptz(6)

  org            Organization       @relation(fields: [org_id], references: [org_id], onDelete: Cascade)
  created_by_user User?             @relation("MemberCreatedBy", fields: [created_by], references: [id])
  group_memberships GroupMembership[]
  linked_archives ArchiveEntry[]    @relation("MemberLinkedArchive")

  @@index([org_id])
  @@index([statut_membre])
  // CHECK: statut_membre IN ('active','inactive','deceased','transferred') — enforced in migration
  @@map("members")
}

// === EVENT RECORD (Table 9: events) — ResourceAggregate ===
// Source: DOC-021 §3.3, DDL §Table 9
model Event {
  id              String   @id @default(uuid()) @db.Uuid
  org_id          String   @map("org_id") @db.Uuid
  created_by      String?  @map("created_by") @db.Uuid
  titre           String   @map("titre") @db.VarChar(255)
  type_evenement  String   @map("type_evenement") @db.VarChar(50)
  date_debut      DateTime @map("date_debut") @db.Timestamptz(6)
  date_fin        DateTime @map("date_fin") @db.Timestamptz(6)
  lieu            String?  @map("lieu") @db.VarChar(255)
  responsable     String?  @map("responsable") @db.Uuid
  description     String?  @db.VarChar(1024)
  statut          String   @map("statut") @db.VarChar(20) @default("draft")
  est_synchronise Boolean  @map("est_synchronise") @default(false)
  conflict_strategy String @map("conflict_strategy") @db.VarChar(32) @default("LWW")
  is_deleted      Boolean  @map("is_deleted") @default(false)
  purge_eligible_at DateTime? @map("purge_eligible_at") @db.Timestamptz(6)
  created_at      DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  version         Int      @map("version") @default(1)
  synced_at       DateTime? @map("synced_at") @db.Timestamptz(6)
  local_updated_at DateTime? @map("local_updated_at") @db.Timestamptz(6)

  org            Organization  @relation(fields: [org_id], references: [org_id], onDelete: Cascade)
  created_by_user User?        @relation("EventCreatedBy", fields: [created_by], references: [id])
  responsable_user User?       @relation("EventResponsable", fields: [responsable], references: [id])

  @@index([org_id])
  @@index([date_debut])
  // CHECK: date_fin > date_debut — enforced in migration
  // CHECK: statut IN ('draft','published','cancelled','completed') — enforced in migration
  @@map("events")
}

// === CATEGORY RECORD (Table 10: categories) — ResourceAggregate ===
// Source: DOC-021 §3.4, DDL §Table 10
model Category {
  id                String   @id @default(uuid()) @db.Uuid
  org_id            String   @map("org_id") @db.Uuid
  cle_vocabulaire   String   @map("cle_vocabulaire") @db.VarChar(255)
  libelle           String   @map("libelle") @db.VarChar(255)
  couleur_associee  String?  @map("couleur_associee") @db.VarChar(7)
  active            Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  synced_at         DateTime? @db.Timestamptz(6)

  org              Organization  @relation(fields: [org_id], references: [org_id], onDelete: Cascade)

  @@index([org_id])
  // CHECK: couleur IS NULL OR couleur ~ '^#[0-9a-fA-F]{6}$' — enforced in migration
  @@map("categories")
}

// === GROUP MEMBERSHIP (Table 11: group_memberships) — RelationshipAggregate ===
// Source: DOC-021 §4.1, DDL §Table 11
model GroupMembership {
  id            String   @id @default(uuid()) @db.Uuid
  org_id        String   @map("org_id") @db.Uuid
  membre_id     String   @map("membre_id") @db.Uuid
  groupe_id     String   @map("groupe_id") @db.Uuid
  date_adhesion DateTime @map("date_adhesion") @db.Date
  date_depart   DateTime?  @map("date_depart") @db.Date
  role_groupe   String?  @map("role_groupe") @db.VarChar(100)

  org     Organization @relation("GroupMembOrg", fields: [org_id], references: [org_id], onDelete: Cascade)
  member  Member       @relation(fields: [membre_id], references: [id])
  group   OrgUnit      @relation(fields: [groupe_id], references: [id])

  @@unique([membre_id, groupe_id])
  @@index([org_id])
  @@map("group_memberships")
}

// === ORG UNIT LINK (Table 12: org_unit_links) — RelationshipAggregate ===
// Source: DOC-021 §4.2, DDL §Table 12
model OrgUnitLink {
  id                String   @id @default(uuid()) @db.Uuid
  org_id            String   @map("org_id") @db.Uuid
  enfant_id         String   @map("enfant_id") @db.Uuid
  parent_id         String   @map("parent_id") @db.Uuid
  date_modification DateTime @map("date_modification") @db.Timestamptz(6) @default(now())

  org      Organization @relation("OrgLinkOrg", fields: [org_id], references: [org_id], onDelete: Cascade)
  enfant   OrgUnit      @relation("OrgUnitLinkEnfant", fields: [enfant_id], references: [id])
  parent   OrgUnit      @relation("OrgUnitLinkParent", fields: [parent_id], references: [id])

  @@index([org_id])
  @@map("org_unit_links")
}

// === WORKFLOW INSTANCE (Table 13: workflow_instances) — WorkflowAggregate ===
// Source: DOC-021 §5.1, DDL §Table 13
model WorkflowInstance {
  id              String   @id @default(uuid()) @db.Uuid
  org_id          String   @map("org_id") @db.Uuid
  ressource_type  String   @map("ressource_type") @db.VarChar(50)
  ressource_id    String   @map("ressource_id") @db.Uuid
  definition_key  String   @map("definition_key") @db.VarChar(255)
  etape_courante  Int      @map("etape_courante") @default(0)
  total_etapes    Int      @map("total_etapes")
  statut          String   @map("statut") @db.VarChar(20) @default("running")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  date_completion DateTime? @map("date_completion") @db.Timestamptz(6)
  date_annulation DateTime? @map("date_annulation") @db.Timestamptz(6)
  date_ecoulement DateTime? @map("date_ecoulement") @db.Timestamptz(6)
  version         Int      @default(1)
  synced_at       DateTime? @db.Timestamptz(6)

  org            Organization       @relation(fields: [org_id], references: [org_id], onDelete: Cascade)
  steps          WorkflowStep[]
  logs           WorkflowLog[]

  @@index([org_id])
  @@index([statut])
  // CHECK: statut IN ('running','completed','failed','cancelled') — enforced in migration
  @@map("workflow_instances")
}

// === WORKFLOW STEP (Table 14: workflow_steps) — WorkflowAggregate ===
// Source: DOC-021 §5.2, DDL §Table 14
model WorkflowStep {
  id                        String   @id @default(uuid()) @db.Uuid
  instance_id               String   @map("instance_id") @db.Uuid
  ordre                     Int      @default(1)
  type_etape                String   @map("type_etape") @db.VarChar(20)
  assigne_a_role            String   @map("assigne_a_role") @db.VarChar(20)
  statut                    String   @default("pending") @db.VarChar(20)
  timeout_jours             Int      @map("timeout_jours")
  commentaire_approbation   String?  @map("commentaire_approbation") @db.VarChar(1024)
  date_ecoulement           DateTime? @map("date_ecoulement") @db.Timestamptz(6)
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @default(now()) @db.Timestamptz(6)

  instance  WorkflowInstance  @relation(fields: [instance_id], references: [id], onDelete: Cascade)
  logs      WorkflowLog[]

  @@index([instance_id])
  // CHECK: type_etape IN ('auto','approval','notification','conditional','delay','parallel') — enforced in migration
  // CHECK: statut IN ('pending','in_progress','completed','failed','skipped') — enforced in migration
  // CHECK: timeout_jours > 0 AND timeout_jours <= 30 — enforced in migration
  @@map("workflow_steps")
}

// === WORKFLOW LOG (Table 15: workflow_logs) — WorkflowAggregate ===
// Source: DOC-021 §5.3, DDL §Table 15
model WorkflowLog {
  id          String   @id @default(uuid()) @db.Uuid
  instance_id String   @map("instance_id") @db.Uuid
  etape_id    String?  @map("etape_id") @db.Uuid
  action      String   @db.VarChar(50)
  execute_par String   @map("execute_par") @db.Uuid
