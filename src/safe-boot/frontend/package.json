{
  "name": "@lumina/frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --coverage",
    "e2e": "detox build --configuration ios.debug && detox test --configuration ios.debug"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"]
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~6.3.0",
    "expo-localization": "~16.0.0",
    "expo-network": "~7.0.0",
    "expo-file-system": "~18.0.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-screens": "~4.4.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@react-native-community/netinfo": "~11.5.2",
    "@reduxjs/toolkit": "^2.3.0",
    "react-redux": "^9.1.2",
    "@tanstack/react-query": "^5.62.0",
    "i18next": "^23.16.0",
    "react-i18next": "^15.1.0",
    "@nozbe/watermelondb": "^0.25.1",
    "@nozbe/with-observables": "^1.6.0",
    "nanoid": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@babel/core": "^7.26.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.12",
    "detox": "^20.33.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "~5.7.0",
    "nativewind": "^4.1.23"
  }
}
